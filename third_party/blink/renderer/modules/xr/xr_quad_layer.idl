[
    SecureContext,
    Exposed=Window,
    RuntimeEnabled=WebXRLayers
]
interface XRQuadLayer : XRCompositionLayer {
  [RaisesException] attribute XRSpace space;
  attribute XRRigidTransform transform;

  attribute float width;
  attribute float height;
};
